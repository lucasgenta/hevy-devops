# =============================================================================
# Hevy DevOps — .gitignore
# =============================================================================

# --- Environment ---
.env
.env.local
*.env

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
*.egg

# --- IDE & Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Runtime data (excluded by design — use Docker volumes) ---
/data/raw/*.json

# --- Docker ---
.docker/

# --- OS ---
Thumbs.db
