# =============================================================================
# Hevy DevOps — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ---- Required: Hevy API ----
# Get your API key at: https://hevy.com/settings?developer
HEVY_API_KEY=your-hevy-api-key-here

# ---- Optional: Deepseek AI ----
# Used by the AI Coach and AI Nutritionist features.
# Get a key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ---- Optional: Asana Integration ----
# Used by the AI Nutritionist to create shopping lists in Asana.
ASANA_ACCESS_TOKEN=
ASANA_SHOPPING_PROJECT_GID=

# ---- Optional: Telegram Bot ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Optional: Scraper Configuration ----
# SCRAPE_INTERVAL=21600
# SCRAPE_ONCE=0
